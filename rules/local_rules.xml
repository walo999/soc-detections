<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="cowrie,honeypot,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>Honeypot Cowrie: zdarzenie</description>
  </rule>

  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Honeypot: nieudane logowanie $(username) z $(src_ip)</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Honeypot: przyjete poswiadczenia $(username)/$(password) z $(src_ip)</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.command\.input$</field>
    <description>Honeypot: komenda wykonana przez $(src_ip)</description>
    <mitre><id>T1059</id></mitre>
  </rule>

  <rule id="100104" level="6">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.file_download$</field>
    <description>Honeypot: zapis pliku na hoscie przez $(src_ip)</description>
  </rule>

</group>

<group name="cowrie,honeypot,canary,">

  <rule id="100110" level="3">
    <if_sid>100101,100102</if_sid>
    <field name="username" type="pcre2">^soctest</field>
    <description>Kontrola potoku: wlasne logowanie testowe z $(src_ip)</description>
  </rule>

  <rule id="100111" level="3">
    <if_sid>100103</if_sid>
    <field name="input" type="pcre2">soc-canary</field>
    <description>Kontrola potoku: wlasna komenda testowa z $(src_ip)</description>
  </rule>

</group>

<group name="cowrie,honeypot,persistence,">
  <rule id="100105" level="13">
    <if_sid>100104</if_sid>
    <field name="destfile" type="pcre2">authorized_keys</field>
    <description>Honeypot: trwaly dostep - klucz SSH dopisany do $(destfile) przez $(src_ip)</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>
  <rule id="100106" level="13">
    <if_sid>100104</if_sid>
    <field name="destfile" type="pcre2">\.ppk$|id_rsa|id_ed25519|sshcfg|ssh_config</field>
    <description>Honeypot: material do ruchu bocznego zapisany w $(destfile) przez $(src_ip)</description>
    <mitre><id>T1021.004</id></mitre>
  </rule>
  <rule id="100107" level="14">
    <if_sid>100104</if_sid>
    <field name="shasum" type="pcre2">^a8460f446be540410004b1a8db4083773fa46f7fe76fa84219c93daa1669f8f2$</field>
    <description>Honeypot: klucz kampanii Outlaw/Dota (mdrfckr) od $(src_ip)</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>
</group>

<group name="cowrie,honeypot,recon,">
  <rule id="100108" level="3">
    <if_sid>100103</if_sid>
    <field name="input" type="pcre2">^\s*(/[\w./]*)?(uname|lscpu|nproc|uptime|whoami|hostname|arch|id|w|last|free|df|lspci)( [\w. /-]*)?$</field>
    <description>Honeypot: rozpoznanie systemu przez $(src_ip)</description>
    <mitre><id>T1082</id></mitre>
  </rule>
</group>

<group name="cowrie,honeypot,ingress,">
  <rule id="100109" level="12">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.file_upload$</field>
    <description>Honeypot: plik $(filename) przeslany kanalem SCP/SFTP przez $(src_ip)</description>
    <mitre><id>T1105</id></mitre>
  </rule>
</group>

<group name="cowrie,honeypot,evasion,">
  <rule id="100112" level="5">
    <if_sid>100103</if_sid>
    <field name="input" type="pcre2">check_[0-9a-f]{32}_(small_|transport_done)|===SHELL_BEHAVIOR===</field>
    <description>Honeypot: test autentycznosci powloki przez $(src_ip)</description>
    <mitre><id>T1497.001</id></mitre>
  </rule>
</group>
